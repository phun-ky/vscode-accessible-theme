{
  "name": "vscode-accessible-theme",
  "version": "1.0.47",
  "description": "WCAG AA-friendly syntax highlighting in dark and light variants.",
  "keywords": [
    "AA",
    "WCAG",
    "a11y",
    "accessibility",
    "accessible",
    "syntax-highlighting",
    "theme",
    "themes",
    "vscode"
  ],
  "homepage": "https://github.com/phun-ky/vscode-accessible-theme#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/vscode-accessible-theme/issues"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/vscode-accessible-theme.git"
  },
  "scripts": {
    "bestpractices:url": "node scripts/bestpractices-url.mjs",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "check:pack": "node scripts/check-pack.mjs vscode-accessible-theme.vsix",
    "commit": "npx git-cz",
    "package": "vsce package --no-dependencies --out vscode-accessible-theme.vsix",
    "prepare": "git config core.hooksPath .githooks || true",
    "publish:marketplace": "vsce publish --oidc --skip-duplicate --packagePath vscode-accessible-theme.vsix",
    "publish:openvsx": "if [ \"$OPENVSX_PUBLISH\" = true ]; then ovsx publish vscode-accessible-theme.vsix --trusted-publishing --skip-duplicate; else echo \"Skipping Open VSX: the OPENVSX_PUBLISH variable is not true\"; fi",
    "release": "release-it",
    "release:dry-run": ".github/scripts/should-release.sh && release-it --ci --dry-run --github.release=false --no-git.requireCleanWorkingDir --no-git.requireUpstream",
    "style:format": "eslint . --fix && prettier --write '**/*.{json,yml,yaml}'",
    "style:format-check": "prettier --check '**/*.{json,yml,yaml}'",
    "style:lint": "eslint .",
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.0.0",
    "eslint-config-phun-ky": "^2.0.11",
    "git-cz": "^4.9.0",
    "globals": "^17.14.0",
    "ovsx": "^1.3.0",
    "prettier": "^3.8.0",
    "release-it": "^21.1.0"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.6"
    }
  },
  "engines": {
    "vscode": ">=1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Accessible (AA) Dark",
        "path": "./themes/accessible-dark-color-theme.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Accessible (AA) Light",
        "path": "./themes/accessible-light-color-theme.json",
        "uiTheme": "vs"
      }
    ]
  },
  "displayName": "Accessible (AA) Theme",
  "publisher": "phun-ky"
}
